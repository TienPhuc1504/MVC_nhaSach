@model IEnumerable<Category>
@{
    ViewData["Title"] = "Quản lý danh mục";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Danh mục</h1>
    <a class="btn btn-primary" asp-action="Create">Thêm danh mục</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-secondary">Chưa có danh mục nào.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead><tr><th>Tên danh mục</th><th>Mô tả</th><th>Số sách</th><th class="text-end">Thao tác</th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@(item.Description ?? "—")</td>
                    <td>@item.Books.Count</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id">Chi tiết</a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Sửa</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Xóa</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
