@model Category
@{ ViewData["Title"] = "Thêm danh mục"; }
<h1 class="h3">Thêm danh mục</h1>
<form asp-action="Create" method="post" class="card card-body shadow-sm">
    <partial name="_Form" model="Model" />
    <div><button class="btn btn-primary" type="submit">Lưu</button> <a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
