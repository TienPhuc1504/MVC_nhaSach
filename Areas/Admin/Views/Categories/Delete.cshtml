@model Category
@{ ViewData["Title"] = "Xóa danh mục"; }
<h1 class="h3 text-danger">Xóa danh mục</h1>
<div class="alert alert-warning">Bạn có chắc muốn xóa danh mục <strong>@Model.Name</strong>?</div>
@if (Model.Books.Count > 0)
{
    <div class="alert alert-danger">Danh mục đang có @Model.Books.Count sách nên không thể xóa.</div>
}
<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button class="btn btn-danger" type="submit" disabled="@(Model.Books.Count > 0 ? "disabled" : null)">Xác nhận xóa</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a>
</form>
