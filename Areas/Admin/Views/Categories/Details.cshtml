@model Category
@{ ViewData["Title"] = "Chi tiết danh mục"; }
<h1 class="h3">Chi tiết danh mục</h1>
<dl class="row card card-body shadow-sm">
    <dt class="col-sm-3">Tên danh mục</dt><dd class="col-sm-9">@Model.Name</dd>
    <dt class="col-sm-3">Mô tả</dt><dd class="col-sm-9">@(Model.Description ?? "—")</dd>
    <dt class="col-sm-3">Số sách</dt><dd class="col-sm-9">@Model.Books.Count</dd>
</dl>
<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Sửa</a>
<a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a>
