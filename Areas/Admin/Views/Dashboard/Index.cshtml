@model MVC_nhaSach.Areas.Admin.ViewModels.DashboardViewModel
@using System.Text.Json
@{ ViewData["Title"] = "Dashboard"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div><div class="admin-kicker">Trung tâm điều hành</div><h1 class="display-5 mb-1">Tổng quan hôm nay</h1><p class="text-muted mb-0">Theo dõi doanh thu, đơn hàng và tồn kho tại một nơi.</p></div>
    <small class="text-muted">Doanh thu chỉ tính đơn đã hoàn thành</small>
</div>

<div class="metric-grid mb-4">
    <div class="metric-card primary"><div class="metric-label">Doanh thu hoàn thành</div><div class="metric-value">@Model.TotalRevenue.ToString("N0") đ</div></div>
    <div class="metric-card"><div class="metric-label">Đơn hàng</div><div class="metric-value">@Model.TotalOrders</div></div>
    <div class="metric-card"><div class="metric-label">Đầu sách</div><div class="metric-value">@Model.TotalBooks</div></div>
    <div class="metric-card"><div class="metric-label">Tồn kho thấp ≤ 5</div><div class="metric-value">@Model.LowStockBooksCount</div></div>
    <div class="metric-card"><div class="metric-label">Người dùng</div><div class="metric-value">@Model.TotalUsers</div></div>
</div>

<div class="card admin-panel mb-4"><div class="card-body p-4"><div class="section-eyebrow">6 tháng gần nhất</div><h2 class="h3">Nhịp doanh thu</h2><div style="height: 300px"><canvas id="revenueChart" aria-label="Biểu đồ doanh thu theo tháng"></canvas></div></div></div>

<div class="row g-4 mb-4">
    <div class="col-lg-6"><div class="card admin-panel h-100"><div class="card-header">Top 5 sách bán chạy</div><div class="table-responsive"><table class="table mb-0 align-middle"><thead><tr><th>Sách</th><th>Đã bán</th><th>Doanh thu</th></tr></thead><tbody>
        @if (Model.TopSellingBooks.Count == 0) { <tr><td colspan="3" class="text-center text-muted py-4">Chưa có đơn hoàn thành.</td></tr> }
        @foreach (var item in Model.TopSellingBooks) { <tr><td><a asp-area="Admin" asp-controller="Books" asp-action="Details" asp-route-id="@item.BookId">@item.Title</a></td><td>@item.QuantitySold</td><td>@item.Revenue.ToString("N0") đ</td></tr> }
    </tbody></table></div></div></div>
    <div class="col-lg-6"><div class="card admin-panel h-100"><div class="card-header">Đơn hàng mới nhất</div><div class="table-responsive"><table class="table mb-0 align-middle"><thead><tr><th>Mã</th><th>Khách hàng</th><th>Tổng tiền</th><th>Trạng thái</th></tr></thead><tbody>
        @if (Model.LatestOrders.Count == 0) { <tr><td colspan="4" class="text-center text-muted py-4">Chưa có đơn hàng.</td></tr> }
        @foreach (var order in Model.LatestOrders) { <tr><td><a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id">#@order.Id</a></td><td>@order.CustomerName</td><td>@order.TotalAmount.ToString("N0") đ</td><td><span class="badge bg-secondary">@order.Status.GetDisplayName()</span></td></tr> }
    </tbody></table></div></div></div>
</div>

<div class="card admin-panel"><div class="card-header">Sách có tồn kho thấp</div><div class="table-responsive"><table class="table mb-0 align-middle"><thead><tr><th>Sách</th><th>Danh mục</th><th>Tồn kho</th><th></th></tr></thead><tbody>
    @if (Model.LowStockBooks.Count == 0) { <tr><td colspan="4" class="text-center text-muted py-4">Không có sách sắp hết hàng.</td></tr> }
    @foreach (var book in Model.LowStockBooks) { <tr><td>@book.Title</td><td>@book.Category.Name</td><td><span class="badge @(book.StockQuantity == 0 ? "bg-danger" : "bg-warning text-dark")">@book.StockQuantity</span></td><td><a class="btn btn-sm btn-outline-primary" asp-area="Admin" asp-controller="Books" asp-action="Edit" asp-route-id="@book.Id">Cập nhật kho</a></td></tr> }
</tbody></table></div></div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script>
        const chartElement = document.getElementById('revenueChart');
        new Chart(chartElement, {
            type: 'bar',
            data: {
                labels: @Html.Raw(JsonSerializer.Serialize(Model.RevenueByMonth.Select(item => item.Label))),
                datasets: [{
                    label: 'Doanh thu (VNĐ)',
                    data: @Html.Raw(JsonSerializer.Serialize(Model.RevenueByMonth.Select(item => item.Revenue))),
                    backgroundColor: 'rgba(23, 60, 53, 0.78)',
                    borderColor: 'rgb(23, 60, 53)',
                    borderWidth: 1,
                    borderRadius: 5
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: { y: { beginAtZero: true, ticks: { callback: value => new Intl.NumberFormat('vi-VN').format(value) + ' đ' } } },
                plugins: { legend: { display: false }, tooltip: { callbacks: { label: context => new Intl.NumberFormat('vi-VN').format(context.raw) + ' đ' } } }
            }
        });
    </script>
}
