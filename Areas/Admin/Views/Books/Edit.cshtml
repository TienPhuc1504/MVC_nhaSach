@model MVC_nhaSach.Areas.Admin.ViewModels.BookFormViewModel
@{ ViewData["Title"] = "Sửa sách"; }
<h1 class="h3">Sửa sách</h1>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="card card-body shadow-sm">
    <input asp-for="Id" type="hidden" />
    <partial name="_Form" model="Model" />
    <div><button class="btn btn-primary" type="submit">Cập nhật</button> <a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
