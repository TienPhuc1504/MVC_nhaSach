@model IEnumerable<Book>
@{
    ViewData["Title"] = "Quản lý sách";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Sách</h1>
    <a class="btn btn-primary" asp-action="Create">Thêm sách</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-secondary">Chưa có sách nào.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead><tr><th>Ảnh</th><th>Tên sách</th><th>Tác giả</th><th>Danh mục</th><th>Giá</th><th>Tồn</th><th class="text-end">Thao tác</th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@if (item.ImagePath is not null) { <img src="@item.ImagePath" alt="Bìa @item.Title" width="48" height="64" class="object-fit-cover rounded" /> } else { <span>—</span> }</td>
                    <td>@item.Title @if (item.IsFeatured) { <span class="badge bg-warning text-dark">Nổi bật</span> }</td>
                    <td>@item.Author</td><td>@item.Category.Name</td><td>@item.Price.ToString("N0") đ</td><td>@item.StockQuantity</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id">Chi tiết</a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Sửa</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Xóa</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
