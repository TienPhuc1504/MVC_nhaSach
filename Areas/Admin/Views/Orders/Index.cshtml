@model MVC_nhaSach.Areas.Admin.ViewModels.OrderListViewModel
@{ ViewData["Title"] = "Quản lý đơn hàng"; }

<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="h3 mb-0">Đơn hàng</h1><span>@Model.Orders.Count đơn</span></div>
<form method="get" class="card card-body shadow-sm mb-4"><div class="row g-3">
    <div class="col-md-5"><label asp-for="Customer" class="form-label">Khách hàng hoặc điện thoại</label><input asp-for="Customer" class="form-control" /></div>
    <div class="col-md-4"><label asp-for="Status" class="form-label">Trạng thái</label><select asp-for="Status" asp-items="Html.GetEnumSelectList<OrderStatus>()" class="form-select"><option value="">Tất cả trạng thái</option></select></div>
    <div class="col-md-3 d-flex align-items-end gap-2"><button class="btn btn-primary" type="submit">Lọc</button><a class="btn btn-outline-secondary" asp-action="Index">Xóa lọc</a></div>
</div></form>
@if (Model.Orders.Count == 0) { <div class="alert alert-secondary">Không có đơn hàng phù hợp.</div> }
else { <div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>Mã</th><th>Khách hàng</th><th>Ngày đặt</th><th>Sản phẩm</th><th>Tổng tiền</th><th>Trạng thái</th><th></th></tr></thead><tbody>
@foreach (var order in Model.Orders) { <tr><td>#@order.Id</td><td>@order.CustomerName<div class="small text-muted">@order.Phone</div></td><td>@order.OrderDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@order.OrderDetails.Sum(item => item.Quantity)</td><td>@order.TotalAmount.ToString("N0") đ</td><td><span class="badge bg-secondary">@order.Status.GetDisplayName()</span></td><td><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@order.Id">Chi tiết</a></td></tr> }
</tbody></table></div> }
