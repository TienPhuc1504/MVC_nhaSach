@model Order
@{ ViewData["Title"] = $"Đơn hàng #{Model.Id}"; }

<div class="d-flex justify-content-between align-items-center mb-4"><h1 class="h3 mb-0">Đơn hàng #@Model.Id</h1><span class="badge bg-secondary fs-6">@Model.Status.GetDisplayName()</span></div>
<div class="row g-4"><div class="col-lg-8"><div class="card shadow-sm"><div class="card-header fw-semibold">Chi tiết sản phẩm</div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Sách</th><th>Đơn giá</th><th>SL</th><th>Thành tiền</th></tr></thead><tbody>
@foreach (var detail in Model.OrderDetails) { <tr><td>@detail.Book.Title</td><td>@detail.UnitPrice.ToString("N0") đ</td><td>@detail.Quantity</td><td>@((detail.UnitPrice * detail.Quantity).ToString("N0")) đ</td></tr> }
</tbody><tfoot><tr><th colspan="3" class="text-end">Tổng cộng</th><th>@Model.TotalAmount.ToString("N0") đ</th></tr></tfoot></table></div></div></div>
<div class="col-lg-4"><div class="card card-body shadow-sm mb-3"><h2 class="h5">Khách hàng</h2><p class="mb-1"><strong>@Model.CustomerName</strong></p><p class="mb-1">@Model.Phone</p><p>@Model.Address</p><small class="text-muted">Tài khoản: @Model.User.Email</small></div>
    @if (Model.Status is not OrderStatus.Completed and not OrderStatus.Cancelled)
    {
        <form asp-action="UpdateStatus" method="post" class="card card-body shadow-sm"><input type="hidden" name="id" value="@Model.Id" /><label for="status" class="form-label fw-semibold">Cập nhật trạng thái</label><select id="status" name="status" asp-items="Html.GetEnumSelectList<OrderStatus>()" class="form-select mb-3"></select><button class="btn btn-primary" type="submit">Cập nhật</button><small class="text-muted mt-2">Hủy đơn sẽ hoàn lại tồn kho đúng một lần.</small></form>
    }
    else { <div class="alert alert-secondary">Đơn hàng đã ở trạng thái kết thúc.</div> }
</div></div>
<a class="btn btn-link ps-0 mt-3" asp-action="Index">← Danh sách đơn hàng</a>
