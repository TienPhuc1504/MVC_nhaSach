@model MVC_nhaSach.ViewModels.Orders.CheckoutViewModel
@using MVC_nhaSach.Models
@{
    ViewData["Title"] = "Đặt hàng";
    IReadOnlyList<CartItem> cartItems = ViewBag.CartItems as IReadOnlyList<CartItem> ?? Array.Empty<CartItem>();
    var total = cartItems.Sum(item => item.LineTotal);
}

<h1 class="h2 mb-4">Thông tin đặt hàng</h1>
<div class="row g-4">
    <div class="col-lg-7"><form asp-action="Checkout" method="post" class="card card-body shadow-sm">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="mb-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                <label asp-for="CustomerName" class="form-label mb-0"></label>
                <div class="btn-group btn-group-sm" role="group" aria-label="Chọn người nhận">
                <input asp-for="DeliverToMyself" class="btn-check" type="radio" value="true" id="deliver-to-myself" autocomplete="off" />
                <label class="btn btn-outline-primary" for="deliver-to-myself">Đặt cho mình</label>
                <input asp-for="DeliverToMyself" class="btn-check" type="radio" value="false" id="deliver-to-other" autocomplete="off" checked="@(Model.DeliverToMyself ? null : "checked")" />
                <label class="btn btn-outline-primary" for="deliver-to-other">Đặt cho người khác</label>
                </div>
            </div>
            <input asp-for="CustomerName" class="form-control" autocomplete="name" />
            <span asp-validation-for="CustomerName" class="text-danger"></span>
            <div class="form-text">Chọn “Đặt cho mình” để tự điền từ hồ sơ cá nhân.</div>
        </div>
        <div class="mb-3"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" autocomplete="tel" /><span asp-validation-for="Phone" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Address" class="form-label"></label><textarea asp-for="Address" class="form-control" rows="3" autocomplete="street-address"></textarea><span asp-validation-for="Address" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Note" class="form-label"></label><textarea asp-for="Note" class="form-control" rows="3" placeholder="Ví dụ: che tên sản phẩm khi giao hàng."></textarea><span asp-validation-for="Note" class="text-danger"></span></div>
        <button class="btn btn-primary btn-lg" type="submit">Xác nhận đặt hàng</button>
    </form></div>
    <div class="col-lg-5"><div class="card shadow-sm"><div class="card-header fw-semibold">Đơn hàng của bạn</div><ul class="list-group list-group-flush">
        @foreach (var item in cartItems) { <li class="list-group-item d-flex justify-content-between"><span>@item.Title × @item.Quantity</span><strong>@item.LineTotal.ToString("N0") đ</strong></li> }
    </ul><div class="card-body d-flex justify-content-between fs-5"><span>Tổng cộng</span><strong class="text-danger">@total.ToString("N0") đ</strong></div></div></div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const fields = {
                name: document.getElementById('CustomerName'),
                phone: document.getElementById('Phone'),
                address: document.getElementById('Address')
            };
            const profile = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
                name = ViewBag.ProfileName ?? string.Empty,
                phone = ViewBag.ProfilePhone ?? string.Empty,
                address = ViewBag.ProfileAddress ?? string.Empty
            }));
            const myself = document.getElementById('deliver-to-myself');
            const other = document.getElementById('deliver-to-other');
            const fillProfile = () => {
                if (!myself.checked) return;
                fields.name.value = profile.name;
                fields.phone.value = profile.phone;
                fields.address.value = profile.address;
            };
            myself.addEventListener('change', fillProfile);
            other.addEventListener('change', () => {
                if (!other.checked) return;
                Object.values(fields).forEach(field => field.value = '');
            });
            fillProfile();
        })();
    </script>
}
