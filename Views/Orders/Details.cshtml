@model Order
@{ ViewData["Title"] = $"Đơn hàng #{Model.Id}"; }

<div class="d-flex justify-content-between align-items-center mb-4"><h1 class="h2 mb-0">Đơn hàng #@Model.Id</h1><span class="badge bg-secondary fs-6">@Model.Status.GetDisplayName()</span></div>
<div class="row g-4"><div class="col-lg-8"><div class="card shadow-sm"><div class="card-header fw-semibold">Sản phẩm</div><div class="table-responsive"><table class="table mb-0 align-middle">
    <thead><tr><th>Sách</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th></tr></thead><tbody>
    @foreach (var detail in Model.OrderDetails) { <tr><td>@detail.Book.Title</td><td>@detail.UnitPrice.ToString("N0") đ</td><td>@detail.Quantity</td><td>@((detail.UnitPrice * detail.Quantity).ToString("N0")) đ</td></tr> }
    </tbody><tfoot><tr><th colspan="3" class="text-end">Tổng cộng</th><th class="text-danger">@Model.TotalAmount.ToString("N0") đ</th></tr></tfoot>
</table></div></div></div>
<div class="col-lg-4"><div class="card card-body shadow-sm"><h2 class="h5">Thông tin nhận hàng</h2><p class="mb-1"><strong>@Model.CustomerName</strong></p><p class="mb-1">@Model.Phone</p><p class="mb-0">@Model.Address</p><hr /><small class="text-muted">Đặt lúc @Model.OrderDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></div></div></div>
<a class="btn btn-link ps-0 mt-3" asp-action="Index">← Đơn hàng của tôi</a>
