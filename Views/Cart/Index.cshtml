@model MVC_nhaSach.ViewModels.Cart.CartViewModel
@{ ViewData["Title"] = "Giỏ hàng"; }

<div class="section-eyebrow">Lựa chọn của bạn</div><div class="page-heading"><h1 class="page-title mb-0">Giỏ sách</h1><span>@Model.TotalQuantity sản phẩm</span></div>
@if (Model.Items.Count == 0)
{
    <div class="empty-state empty-cart"><span class="empty-glyph">∅</span><h2>Giỏ sách đang trống</h2><p>Hãy chọn một cuốn khiến bạn muốn đọc ngay trang đầu.</p><a class="btn btn-primary" asp-controller="Books" asp-action="Index">Khám phá tủ sách</a></div>
}
else
{
    <div class="card admin-panel table-responsive"><table class="table align-middle mb-0">
        <thead><tr><th>Sách</th><th>Đơn giá</th><th style="width:220px">Số lượng</th><th>Thành tiền</th><th></th></tr></thead>
        <tbody>@foreach (var item in Model.Items) { <tr>
            <td><div class="d-flex gap-3 align-items-center">@if (item.ImagePath is not null) { <img src="@item.ImagePath" width="56" height="72" class="object-fit-cover rounded" alt="Bìa @item.Title" /> }<div><a class="fw-semibold text-decoration-none" asp-controller="Books" asp-action="Details" asp-route-id="@item.BookId">@item.Title</a><div class="small text-muted">@item.Author</div><div class="small">Còn @item.StockQuantity trong kho</div></div></div></td>
            <td>@item.UnitPrice.ToString("N0") đ</td>
            <td><form asp-action="Update" method="post" class="d-flex gap-2"><input type="hidden" name="bookId" value="@item.BookId" /><input type="number" name="quantity" value="@item.Quantity" min="1" max="@item.StockQuantity" class="form-control" /><button class="btn btn-outline-primary" type="submit">Cập nhật</button></form></td>
            <td class="fw-semibold">@item.LineTotal.ToString("N0") đ</td>
            <td><form asp-action="Remove" method="post"><input type="hidden" name="bookId" value="@item.BookId" /><button class="btn btn-sm btn-outline-danger" type="submit">Xóa</button></form></td>
        </tr> }</tbody>
    </table></div>
    <div class="row justify-content-end"><div class="col-md-5 col-lg-4"><div class="card card-body shadow-sm">
        <div class="d-flex justify-content-between fs-5 mb-3"><span>Tổng cộng</span><strong class="text-danger">@Model.TotalAmount.ToString("N0") đ</strong></div>
        <a class="btn btn-primary btn-lg" asp-controller="Orders" asp-action="Checkout">Tiến hành đặt hàng</a>
        <form asp-action="Clear" method="post" class="mt-3"><button class="btn btn-link text-danger p-0" type="submit">Xóa toàn bộ giỏ hàng</button></form>
    </div></div></div>
}
